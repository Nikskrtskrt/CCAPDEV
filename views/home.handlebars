<header class="text-center py-5">
    <h1 class="display-3 fw-bold text-light mb-3">Welcome Aboard!</h1>
    <p class="lead text-secondary mb-4">Experience seamless flight booking and management</p>
</header>

<main class="container my-5">
    <section class="row g-4 justify-content-center">

        <div class="col-md-4">
            <div class="card border-primary shadow h-100">
                <div class="card-body text-center d-flex flex-column justify-content-between p-5">
                    <div>
                        <h3 class="card-title display-6">✈️</h3>
                        <h4 class="card-title mb-3">Search Flights</h4>
                        <p class="card-text text-white-50">
                            Browse destinations, check schedules, and find your perfect flight. Log in to book.
                        </p>
                    </div>
                    <a href="/login" class="btn btn-primary btn-lg mt-4"> 
                        Login to Search
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success shadow h-100">
                <div class="card-body text-center d-flex flex-column justify-content-between p-5">
                    <div>
                        <h3 class="card-title display-6">😊</h3>
                        <h4 class="card-title mb-3">View Profile</h4>
                        <p class="card-text text-white-50">
                            Already have an account? Log in to manage your profile, preferences, and bookings.
                        </p>
                    </div>
                    <a href="/login" class="btn btn-success btn-lg mt-4">
                        Login
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-warning shadow h-100">
                <div class="card-body text-center d-flex flex-column justify-content-between p-5">
                    <div>
                        <h3 class="card-title display-6">📃</h3>
                        <h4 class="card-title mb-3">Register</h4>
                        <p class="card-text text-white-50">
                            Create an account to book flights, manage your reservations, and speed up checkout.
                        </p>
                    </div>
                    <a href="/register" class="btn btn-warning btn-lg mt-4 text-dark">
                        Sign Up Now
                    </a>
                </div>
            </div>
        </div>

    </section>
</main>