<header>
    <h1 class="text-center py-3"><b>Admin Panel | Flight Management</b></h1>
</header>

<main>
    <div class="card">
        <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Existing Flights</h3>
        <button class="btn btn-success" id="addFlightBtn">+ Create New Flight</button>
        </div>

        <table class="table table-dark align-middle" id="flightTable">
        <thead>
            <tr>
            <th>Flight Num</th>
            <th>Origin</th>
            <th>Destination</th>
            <th>Departure</th>
            <th>Arrival</th>
            <th>Aircraft</th>
            <th>Capacity</th>
            <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#if flights.length}}
            {{#each flights}}
                <tr>
                <td>{{flightNo}}</td>
                <td>{{origin}}</td>
                <td>{{destination}}</td>
                <td>{{departure}}</td>
                <td>{{arrival}}</td>
                <td>{{aircraft}}</td>
                <td>{{capacity}}</td>
                <td>
                    <button class="btn btn-info btn-sm view-btn" data-id="{{_id}}">View</button>
                    <button class="btn btn-warning btn-sm edit-btn" data-id="{{_id}}">Edit</button>
                    <button class="btn btn-danger btn-sm delete-btn" data-id="{{_id}}">Delete</button>
                </td>
                </tr>
            {{/each}}
            {{else}}
                <div class="alert alert-danger">No Flights Found</div>
            {{/if}}
        </tbody>
        </table>
    </div>
</main>

<div class="modal fade" id="flightModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header">
                <h4 id="modalTitle" class="modal-title">Add Flight</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="flightForm">
                    <input type="hidden" id="flightId" />
                    <div class="row g-3">
                        <div class="col-md-4">
                        <label class="form-label">Flight No.</label>
                        <input type="text" class="form-control" id="flightNo" required>
                        </div>
                        <div class="col-md-4">
                        <label class="form-label">Origin</label>
                        <input type="text" class="form-control" id="origin" required>
                        </div>
                        <div class="col-md-4">
                        <label class="form-label">Destination</label>
                        <input type="text" class="form-control" id="destination" required>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                        <label class="form-label">Departure</label>
                        <input type="time" class="form-control" id="departure" required>
                        </div>
                        <div class="col-md-4">
                        <label class="form-label">Arrival</label>
                        <input type="time" class="form-control" id="arrival" required>
                        </div>
                        <div class="col-md-4">
                        <label class="form-label">Aircraft</label>
                        <input type="text" class="form-control" id="aircraft" required>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                        <label class="form-label">Seat Capacity</label>
                        <input type="number" class="form-control" id="capacity" min="1" required>
                        </div>
                        <div class="col-md-4">
                        <label class="form-label">Season Start</label>
                        <input type="date" class="form-control" id="seasonStart" required>
                        </div>
                        <div class="col-md-4">
                        <label class="form-label">Season End</label>
                        <input type="date" class="form-control" id="seasonEnd" required>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Operating Days</label>
                        <div class="d-flex flex-wrap gap-2">
                        {{#each daysOfWeek}}
                            <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="daysOfWeek" value="{{this}}" id="{{this}}">
                            <label class="form-check-label" for="{{this}}">{{this}}</label>
                            </div>
                        {{/each}}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" id="saveFlightBtn">Save</button>
                    </div>
                </form>
            </div>
            <h5 class="mt-4" id="flightInstancesLabel">Flight Instances</h5>
            <table class="table table-dark table-bordered" id="instancesTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<script src="/js/flights.js"></script>