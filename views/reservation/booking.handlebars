<head>
    <title>Reservation Form</title>
    <!-- Bootstrap CSS (Official website link) -->
    <link rel="stylesheet" href="https://getbootstrap.com/docs/5.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/globals.css">
    </link>
    <link rel="stylesheet" href="/css/reservation-form.css">
    </link>
</head>

<form id="reservationForm">
    <h1 id="titleContainer" data-flight-no="{{flight.flightNo}}" data-date="{{flightInstance.date}}" class="text-center py-3">
        <b>{{title}}</b>
    </h1>

    <div class="row container optional-container">

        <!--
                {{#if flights.length}}
                {{#each flights}}
                <tr>
                    <td>{{flightNo}}</td>
                    <td>{{origin}}</td>
                    <td>{{destination}}</td>
                    <td>{{departure}}</td>
                    <td>{{arrival}}</td>
                    <td>{{aircraft}}</td>
                    <td>{{capacity}}</td>
                    <td>
                        <button class="btn btn-info btn-sm view-btn" data-id="{{_id}}">View</button>
                        <button class="btn btn-warning btn-sm edit-btn" data-id="{{_id}}">Edit</button>
                        <button class="btn btn-danger btn-sm delete-btn" data-id="{{_id}}">Delete</button>
                    </td>
                </tr>
                {{/each}}
                {{else}}
                <div class="alert alert-danger">No Flights Found</div>
                {{/if}}
            -->


    </div>

    <h5 class="py-3 "><b>Flight Details</b></h5>
    <div class="container">

        <div class="row">
            <label class="col-2">Origin:</label>
            <div class="col-2">{{flight.origin}}</div>
            <label class="col-2">Destination:</label>
            <div class="col-2">{{flight.destination}}</div>
        </div>
        <div class="row">
            <label class="col-2">Date:</label>
            <div class="col-2">{{flightInstance.date}}</div>
            <label class="col-2">Flight No.:</label>
            <div class="col-2">{{flight.flightNo}}</div>
        </div>
        <div class="row">
            <label class="col-2">Departure:</label>
            <div class="col-2">{{flight.departure}}</div>
            <label class="col-2">Arrival:</label>
            <div class="col-2">{{flight.arrival}}</div>
        </div>
        <div class="row">
            <br />
            <br />
        </div>
    </div>

    <h5 class="py-3 "><b>User Details</b></h5>
    <div class="container">
        
        <div class="row full-name-container">
            <div class="col-3">
                <label for="firstName" id="labelFirstName" >First Name: </label>
                <input type="text" id="firstName" placeholder="First Name" value="{{user.firstName}}" disabled required></input>
            </div>
            <div class="col-3">
                <label for="lastName" id="labelLastName">Last Name: </label>
                <input type="text" id="lastName" placeholder="Last Name" value="{{user.lastName}}" disabled required></input>
            </div>
        </div>
        <div class="row">
            <div class="col-3 email-container">
                <label for="email" id="labelEmail">Email Address: </label>
                <input type="email" id="email" placeholder="Email Address" value="{{user.email}}" disabled required></input>
            </div>
            <div class="col-3 passport-number-container">
                <label for="passportNumber" id="labelPassport">Passport Number: </label>
                <input type="text" id="passportNumber" placeholder="Passport Number" value="{{user.passportNo}}" disabled required></input>
            </div>
        </div>

    </div>


    <h5 class="py-3 "><br /><br /><b>Packages</b></h5>
    <div class="row container optional-container">
        <div class="col-5">
            <!--Base standard Carry-on is at most 7kg, Extra is at most 32kg-->
            <div class="row">
                <label class="col-8">Free Baggage Allowance: </label>
                <label class="col-1">7kg</label>
            </div>
            <div class="row">
                <label class="col-8 extra-baggage-container">Extra Baggage (+$10 per kg):</label>
                <div class="col-1">
                    <input type="number" id="extraBaggageWeight" name="extra-baggage-weight" min="0" max="30"
                        value="0"></input>
                </div>
            </div>

            <!--
                <label for="extraBaggage">Extra Baggage (+$75):</label>
                <input type="checkbox" id="extraBaggage" name="extra-baggage"></input>
                
                <select id="extraBaggageWeight" name="extra-baggage-weight">
                    <option value="5" selected>Carry-on Baggage 7kg</option>
                    <option value="10">10kg</option>
                    <option value="20">20kg</option>
                    <option value="30">30kg</option>
                </select>
                -->
        </div>
        <div class="col-4 meal-options-container">
            <label class="row" for="mealOptions">Meal Options:</label>
            <select class="row" id="mealOptions" name="meal-options">
                <!--<option value="None" selected>None</option>-->
                <option value="Standard">Standard</option>
                <option value="Vegetarian">Vegetarian (+$100)</option>
                <option value="Kosher">Kosher (+$150)</option>
                <option value="Halal">Halal (+$120)</option>
            </select>
        </div>
    </div>


    <div class="seat-selection-container">
        <h5 for="seat-selection" id="labelSeatSelection"><br /><br /><b>Seat Selection:</b></h5>
        <div id="legendContainer" class="container">
            <div class="row justify-content-center">
                <div class="col-1 legend-color legend-available"></div>
                <div class="col-2 justify-content-center">
                    <label class="legend-label">Available</label>
                </div>
                <div class="col-1 legend-color legend-booked"></div>
                <div class="col-2 justify-content-center">
                    <label class="legend-label">Booked</label>
                </div>
            </div>
        </div>
        <br>
        <div id="seatMapContainer" class="container">
            <!-- Seat will be created in javascript -->
            <!-- Template -->
            <!--
                <div class="row justify-content-center seat-row">
                    <div class="col-1  align-items-center justify-content-center">
                        <div class="seat" >
                            1A
                        </div>
                    </div>
                    <div class="col-1  align-items-center justify-content-center">
                        <div class="seat" data-seat-type>
                            1A
                        </div>
                    </div>
                    <div class="col-1  align-items-center justify-content-center">
                        <div class="seat">
                            1A
                        </div>
                    </div>
                    <div class="col-1 aisle-buffer" style="border: 1px solid red;"></div>
                    
                    <div class="col-1  align-items-center justify-content-center">
                        <div class="seat">
                            1A
                        </div>
                    </div>
                    <div class="col-1  align-items-center justify-content-center">
                        <div class="seat">
                            1A
                        </div>
                    </div>
                    <div class="col-1  align-items-center justify-content-center">
                        <div class="seat">
                            1A
                        </div>
                    </div>
                    
                </div>
                -->

        </div>
    </div>


    <h5 class="py-3 "><br/><b>Summary</b></h5>
    <div class="container" id="summary-container">
        <div class="row">
            <div class="col-2">Base Cost</div>
            <div class="col-3 summary-cost" id="summaryBaseCost">$XXX.XX</div>
        </div>
        <div class="row">
            <div class="col-2">Seat Type</div>
            <div class="col-3 summary-cost" id="summarySeatTypeCost">+$XXX.XX</div>
        </div>
        <div class="row" id="summaryMealOption">
            <div class="col-2">Meal Option</div>
            <div class="col-3 summary-cost" id="summaryMealOptionCost">+$XXX.XX</div>
        </div>
        <div class="row" id="summaryExtraBaggage">
            <div class="col-2">Extra Baggage</div>
            <div class="col-3 summary-cost" id="summaryExtraBaggageCost">+$XXX.XX</div>
        </div>
        <label id="totalCostLabel">Total Cost: $0</label>
    </div>
    <div class="error" id="errorContainer">

    </div>
    <button type="submit" id="submitBtn">Confirm Reservation</button>
</form>

<!-- jQuery (Official website link) -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- Bootstrap JS (Official website link) -->
<script src="https://getbootstrap.com/docs/5.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/reservation-form.js"></script>