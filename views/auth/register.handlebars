<main class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-5 text-light bg-dark" style="width: 400px;">
        <h2 class="text-center mb-4">Register</h2>

        <div id="registerError" class="alert alert-danger text-center" style="display: none;"></div>

        <form id="registerForm">
            <div class="mb-3 text-start">
                <label for="firstName" class="form-label">First Name</label>
                <input type="text" id="firstName" class="form-control" placeholder="Enter your first name" required>
            </div>
            <div class="mb-3 text-start">
                <label for="lastName" class="form-label">Last Name</label>
                <input type="text" id="lastName" class="form-control" placeholder="Enter your last name" required>
            </div>
            <div class="mb-3 text-start">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" class="form-control" placeholder="Enter your email" required>
            </div>
            <div class="mb-3 text-start">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" class="form-control" placeholder="Create a password" required>
            </div>
            <div class="mb-4 text-start">
                <label for="passportNo" class="form-label">Passport Number</label>
                <input type="text" id="passportNo" class="form-control" placeholder="Enter your passport number" required>
            </div>

            <button type="submit" class="btn btn-success w-100 mb-3">Register</button>

            <p class="text-center mt-3 mb-0 text-secondary">
                Already have an account?
                <a href="/login" class="text-warning text-decoration-none">Login here</a>
            </p>
        </form>
    </div>
</main>