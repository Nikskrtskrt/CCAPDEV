<main class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-5 text-light bg-dark" style="width: 400px;">
        <h2 class="text-center mb-4">Login</h2>

        <div id="loginError" class="alert alert-danger text-center" style="display: none;"></div>

        <form id="loginForm">
            <div class="mb-3 text-start">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" required>
            </div>
            <div class="mb-4 text-start">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Login</button>

            <p class="text-center mt-3 mb-0 text-secondary">
                Don't have an account?
                <a href="/register" class="text-warning text-decoration-none">Register here</a>
            </p>
        </form>
    </div>
</main>