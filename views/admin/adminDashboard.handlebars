<header class="text-center py-5">
    <h1 class="display-3 fw-bold text-light mb-3">Admin Dashboard</h1>
    <p class="lead text-secondary mb-4">Manage system data and users</p>
</header>

<main class="container my-5">
    <section class="row g-4 justify-content-center">

        <div class="col-lg-5">
            <div class="card text-bg-dark border-primary shadow h-100">
                <div class="card-body text-center d-flex flex-column justify-content-between p-5">
                    <div>
                        <h3 class="card-title display-6">✈️</h3>
                        <h4 class="card-title mb-3">Flight Management</h4>
                        <p class="card-text text-white-50">
                            Add new flights, edit existing schedules, update pricing, and manage all airline data.
                        </p>
                    </div>
                    <a href="/flights" class="btn btn-primary btn-lg mt-4">
                        Manage Flights
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card text-bg-dark border-success shadow h-100">
                <div class="card-body text-center d-flex flex-column justify-content-between p-5">
                    <div>
                        <h3 class="card-title display-6">😊</h3>
                        <h4 class="card-title mb-3">User Management</h4>
                        <p class="card-text text-white-50">
                            View all registered users, edit profiles, reset passwords, or manage user roles and permissions.
                        </p>
                    </div>
                    <a href="/users" class="btn btn-success btn-lg mt-4">
                        Manage Users
                    </a>
                </div>
            </div>
        </div>

    </section>
</main>