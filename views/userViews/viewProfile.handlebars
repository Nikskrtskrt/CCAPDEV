<header class="text-center py-4">
    <h2 class="text-light">{{user.firstName}}'s' Profile</h2>
    <p class="text-secondary">View and manage your account and reservations</p>
</header>

<main class="container mt-4">
    <div class="card bg-dark text-light p-4 mb-4">
        <h4>Edit Information</h4>
        <form method="POST" action="/api/profile/update" class="row g-3">
        <div class="col-md-6">
            <label class="form-label">First Name</label>
            <input type="text" name="firstName" class="form-control" value="{{user.firstName}}" required>
        </div>
        <div class="col-md-6">
            <label class="form-label">Last Name</label>
            <input type="text" name="lastName" class="form-control" value="{{user.lastName}}" required>
        </div>
        <div class="col-md-6">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" value="{{user.email}}" required>
        </div>
        <div class="col-md-6">
            <label class="form-label">Passport No</label>
            <input type="text" name="passportNo" class="form-control" value="{{user.passportNo}}" required>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary">Save Changes</button>
        </div>
        </form>
    </div>

    <div class="card bg-dark text-light p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>My Reservations</h4>
        </div>
        <div class = "table-responsive">
        <table class="table table-dark align-middle">
        <thead>
            <tr>
            <th>Flight No</th>
            <th>Date</th>
            <th>Seat</th>
            <th>Fare Class</th>
            <th>Total</th>
            <th>Status</th>
            <th>Actions</th>
            </tr>
        </thead>
        <tbody id="reservationTableBody">
            <!--
            {{#if reservations.length}}
            {{#each reservations}}
            <tr data-id="{{_id}}">
                <td>{{flight.flightNo}}</td>
                <td>{{formatDate flight.date}}</td>
                <td>{{seatNo}}</td>
                <td>{{fareClass}}</td>
                <td>{{totalPrice}}</td>
                <td>{{status}}</td>
                <td>
                <button class="btn btn-sm btn-danger delete-reservation-btn">Delete</button>
                </td>
            </tr>
            {{/each}}
            {{else}}
            <tr><td colspan="7" class="text-center text-secondary">No reservations found</td></tr>
            {{/if}}
            -->
            <tr><td colspan="7" class="text-center text-secondary">No reservations found</td></tr>
        </tbody>
        </table>
        </div>
    </div>
</main>

<script src="/js/profile.js"></script>
