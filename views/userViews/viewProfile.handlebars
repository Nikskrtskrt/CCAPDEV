<header class="text-center py-5">
    <h1 class="display-4 fw-bold text-light">{{user.firstName}}'s Profile</h1>
    <p class="lead text-secondary mb-4">View and manage your account and reservations</p>
</header>

<main class="container my-5">
    <section class="row g-4 justify-content-center">

        <div class="col-lg-6 col-md-8">
            <div class="card bg-dark text-light shadow h-100">
                <div class="card-body p-5">
                    <h3 class="display-6 text-center mb-4">Edit Information</h3>

                    <form method="POST" action="/api/profile/update" class="d-flex flex-column gap-3">

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="firstName" class="form-label fw-semibold">First Name</label>
                                <input type="text" id="firstName" name="firstName" class="form-control" value="{{user.firstName}}" required>
                            </div>
                            <div class="col-md-6">
                                <label for="lastName" class="form-label fw-semibold">Last Name</label>
                                <input type="text" id="lastName" name="lastName" class="form-control" value="{{user.lastName}}" required>
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label fw-semibold">Email</label>
                                <input type="email" id="email" name="email" class="form-control" value="{{user.email}}" required>
                            </div>
                            <div class="col-md-6">
                                <label for="passportNo" class="form-label fw-semibold">Passport No</label>
                                <input type="text" id="passportNo" name="passportNo" class="form-control" value="{{user.passportNo}}" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg mt-4 w-100">Save Changes</button>

                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-10">
            <div class="card bg-dark text-light shadow h-100">
                <div class="card-body p-5">
                    <h3 class="display-6 mb-4">My Reservations</h3>

                    <div class="table-responsive">
                        <table class="table table-dark align-middle">
                            <thead>
                                <tr>
                                    <th>Flight No</th>
                                    <th>Date</th>
                                    <th>Seat</th>
                                    <th>Fare Class</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="reservationTableBody">
                                <tr>
                                    <td colspan="7" class="text-center text-secondary">No reservations found</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

    </section>
</main>

<script src="/js/profile.js"></script>
