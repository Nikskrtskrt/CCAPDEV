<header>
    <h1 class="text-center py-3"><b>Admin Panel | User Management</b></h1>
</header>

<main>
    <div class="card bg-dark text-light p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Registered Users</h3>
            <button class="btn btn-success" id="addUserBtn">+ Create New User</button>
        </div>

        <table class="table table-dark align-middle" id="userTable">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Passport No.</th>
                    <th>Role</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                {{#if users.length}}
                    {{#each users}}
                        <tr>
                            <td>{{fullName}}</td>
                            <td>{{email}}</td>
                            <td>{{passportNo}}</td>
                            <td>{{role}}</td>
                            <td class="text-center">
                                <button class="btn btn-info btn-sm view-btn" data-id="{{_id}}">View</button>
                                <button class="btn btn-warning btn-sm edit-btn" data-id="{{_id}}">Edit</button>
                                <button class="btn btn-danger btn-sm delete-btn" data-id="{{_id}}">Delete</button>
                            </td>
                        </tr>
                    {{/each}}
                {{else}}
                    <tr>
                        <td colspan="5">
                            <div class="alert alert-danger text-center">
                                No users found
                            </div>
                        </td>
                    </tr>
                {{/if}}
            </tbody>
        </table>
    </div>
</main>

<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header">
                <h4 id="userModalTitle" class="modal-title">Add User</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="userForm">
                    <input type="hidden" id="userId" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="fullName" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" required>
                        </div>

                        <div class="col-md-6 mt-2">
                            <label class="form-label">Passport No.</label>
                            <input type="text" class="form-control" id="passportNo" required>
                        </div>

                        <div class="col-md-6 mt-2">
                            <label class="form-label">Role</label>
                            <select class="form-select" id="role">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-4 modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" id="saveUserBtn">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="viewUserModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header">
                <h4 id="viewUserModalTitle" class="modal-title">User Details</h4>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <h5>User Information</h5>
                <div class="row">
                    <div class="col-md-4"><b>Name:</b> <span id="v_fullName"></span></div>
                    <div class="col-md-4"><b>Email:</b> <span id="v_email"></span></div>
                    <div class="col-md-4"><b>Role:</b> <span id="v_role"></span></div>
                </div>

                <div class="row mt-2">
                    <div class="col-md-4"><b>Passport No.:</b> <span id="v_passportNo"></span></div>
                </div>

                <hr>

                <h5>Reservations</h5>

                <table class="table table-dark table-bordered" id="reservationsTable">
                    <thead>
                        <tr>
                            <th>Flight No.</th>
                            <th>Date</th>
                            <th>Seat</th>
                            <th>Fare Class</th>
                            <th>Total Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody></tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<script src="/js/users.js"></script>
